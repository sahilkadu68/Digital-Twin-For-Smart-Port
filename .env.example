# Smart Port Digital Twin — Environment Variables
# Copy to .env.local for local development

# API
VITE_API_BASE_URL=http://localhost:8081/api/v1

# App
VITE_APP_NAME="Smart Port Digital Twin"
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_3D=true
VITE_ENABLE_REALTIME=false

# Backend process variables (never expose secrets through VITE_ variables)
# MONGODB_URI=mongodb://127.0.0.1:27017/smart_port_digital_twin
# FRONTEND_ORIGIN=http://localhost:5173
# SESSION_COOKIE_SECURE=false  # MUST be true with HTTPS in deployment
# AUTH_REGISTRATION_ENABLED=true  # disable after approved accounts exist
# AUTH_RATE_WINDOW_SECONDS=900
# AUTH_RATE_IP_LIMIT=30
# AUTH_RATE_ACCOUNT_LIMIT=10
